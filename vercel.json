{
  "framework": null,
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "functions": {
    "api/roster.js": {
      "maxDuration": 60
    },
    "api/sync.js": {
      "maxDuration": 60
    },
    "api/player.js": {
      "maxDuration": 60
    },
    "api/scout.js": {
      "maxDuration": 60
    },
    "api/today.js": {
      "maxDuration": 30
    }
  }
}
